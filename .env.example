PORT=8080
COUNTY=chester-pa
PRIMARY_COUNTY=Chester
STATE=PA
# PASDA MapServer
PASDA_MAPSERVER=https://mapservices.pasda.psu.edu/server/rest/services/pasda/ChesterCounty/MapServer
PARCEL_LAYER=11
# Demo slice around West Chester, PA (full county: set INGEST_MODE=full)
INGEST_MODE=west-chester-slice
MAX_PARCELS=2500
WEST_CHESTER_LAT=39.9607
WEST_CHESTER_LNG=-75.6055
# Optional IPFS pin (Filebase S3-compatible). Without this, CIDs are still computed locally.
FILEBASE_ENDPOINT=
FILEBASE_ACCESS_KEY=
FILEBASE_SECRET_KEY=
FILEBASE_BUCKET=
# Optional LLM for agent; deterministic tools work without it
ANTHROPIC_API_KEY=
